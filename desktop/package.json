{
  "name": "senior-interview-mentor-desktop",
  "version": "1.0.0",
  "description": "Senior Interview Mentor — Desktop App",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n electron,server,client -c magenta,green,blue \"npm run dev:electron\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "cd ../web && npx vite --port 5173",
    "dev:server": "cd ../web && npx tsx watch server/index.ts",
    "dev:electron": "wait-on http://localhost:3001/api/health && npx tsc -p tsconfig.json && electron dist-electron/main.js",
    "build": "npm run build:web && npm run build:electron",
    "build:web": "cd ../web && npm run build",
    "build:electron": "npx tsc -p tsconfig.json",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "electron-store": "^10.0.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "wait-on": "^8.0.0",
    "concurrently": "^9.2.0",
    "typescript": "~5.9.3"
  }
}
